# Python
__pycache__/
.pytest_cache/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.spec
!TarkovStashHelper.spec

# data/ is per-machine runtime state: settings and progress, price/task/wiki caches, the item
# catalog and downloaded images, the game font extracted from the user's install, debug bundles,
# logs, and screenshots of the user's stash (eval frames, collected scenes). None of it belongs in
# the repo - the stash screenshots are private - so ignore everything there but the placeholder.
data/*
!data/.gitkeep

# Virtual envs
venv/
.venv/
env/
.buildvenv*/

# Logs and scratch output (eval printouts, worker notes) anywhere in the tree
*.log
scratch_*

# IDE
.vscode/
.idea/
*.swp

# Claude Code internal state (worktrees, settings)
.claude/
